#!/bin/sh
case "$ACTION" in
add|remove|reload)
        if [ ! -d /sys/class/net/docker0 ]; then
                exit 0
        fi

        if ! uci show firewall.docker >/dev/null 2>&1; then
                uci add firewall zone
                idx=$(uci show firewall.@zone[-1])
                uci set ${idx}.name='docker'
                uci set ${idx}.input='ACCEPT'
                uci set ${idx}.output='ACCEPT'
                uci set ${idx}.forward='ACCEPT'
                uci set ${idx}.masq='1'
                uci add_list ${idx}.network='docker'
        fi

        uci del firewall.docker.device
        for dev in $(ls /sys/class/net | grep "^br-"); do
                uci add_list firewall.docker.device="$dev"
        done

        uci commit firewall
        ;;
esac
